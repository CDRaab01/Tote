# Docker
docker-compose.override.yml

# never commit .env backups (they hold live secrets; timestamped .bak slips past *.env)
.env.bak*
*.env.bak-*

# Gradle build outputs at the android root too (not just app/) — a Windows checkout hits
# MAX_PATH inside these, which makes an accidental commit painful to clean up.
android/build/
android/.kotlin/
