<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading and writing tote tags. Not required: the app is fully usable by search and
         browse on a device with no NFC hardware, so a hard requirement would exclude phones
         for a convenience feature. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Batch capture. Not required hardware: a phone with no camera can still catalogue from
         the gallery, and a hard requirement would exclude devices over a convenience. The
         capture screen requests the runtime grant and falls back to the picker on denial. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Read suite connection config from the Dragonfly hub. Granted only because all suite
         apps share one signing key; harmless if Dragonfly isn't installed. -->
    <uses-permission android:name="com.dragonfly.permission.READ_SUITE_CONFIG" />

    <!-- API 30+ package visibility: needed to resolve Dragonfly's ContentProvider. -->
    <queries>
        <package android:name="com.dragonfly" />
    </queries>

    <application
        android:name=".ToteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tote"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tap a tote's tag and land in that tote.
                 NDEF_DISCOVERED, deliberately NOT an App Links filter with autoVerify: App
                 Links would require a reachable .well-known/assetlinks.json on the host, and
                 the host is tailnet-only. NFC dispatch matches this filter directly with no
                 verification step, which is exactly what is wanted.
                 The port is part of the match: Tote is served on :8448 and the other suite apps
                 share this hostname on different ports. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="dragonfly.tail2ce561.ts.net"
                    android:port="8448"
                    android:pathPrefix="/t/" />
            </intent-filter>
        </activity>

        <!-- AppAuth themes its AuthorizationManagementActivity as AppCompat but leaves
             RedirectUriReceiverActivity to inherit the app theme, which is NOT AppCompat (suite
             apps use android:Theme.Material) - it then crashes on the OAuth redirect with
             "You need to use a Theme.AppCompat theme". Every suite manifest carries this
             override. DO NOT REMOVE IT: the crash happens on the way back from the browser, so
             it is invisible in CI and in every screenshot test, and only shows up on a real
             device at the exact moment a user signs in. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar"
            tools:node="merge" />

        <!-- Hands the camera app a writable target inside our own storage. Without it,
             TakePicture() cannot be given a file:// Uri at all on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tote.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Remove WorkManager's default initialiser so the Hilt worker factory is the one that
             builds UploadWorker. Left in place, WorkManager initialises itself first with the
             default factory and every @HiltWorker fails to construct — at drain time, in the
             background, silently. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
